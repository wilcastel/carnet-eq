{
    "name": "equidad/carnet-equidad",
    "description": "Public digital insurance carnet lookup for La Equidad (Api Data Carnet).",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "setasign/fpdi": "^2.6",
        "tecnickcom/tcpdf": "^6.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "CarnetEquidad\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CarnetEquidad\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
